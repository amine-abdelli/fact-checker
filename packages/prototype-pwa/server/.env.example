# Required — streaming ASR + diarization. Get one at console.deepgram.com
DEEPGRAM_API_KEY=

# Required — claim extraction.
# DEROGATION from project rule 7 ("extraction must use claude-haiku-4-5, never swap"):
# this prototype uses OpenAI by explicit, informed decision of the project owner
# (2026-09-16), for this throwaway prototype only. See app/config.py and README.md.
# Production Stage 3 (packages/back/pipeline) must still use claude-haiku-4-5.
OPENAI_API_KEY=

# Extraction model.
OPENAI_MODEL=gpt-4o-mini

# ASR language (fr or en)
LANGUAGE=fr

# New finalized words buffered before triggering an extraction pass
MIN_WORDS=50

# Minimum seconds between two extraction passes
EXTRACT_INTERVAL=20

# Minimum verifiability_score to display (emit) a claim
SCORE_THRESHOLD=0.6

# Server port
PORT=8000
